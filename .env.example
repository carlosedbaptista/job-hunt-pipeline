# Kimi API (Moonshot AI)
KIMI_API_KEY=your_kimi_api_key_here
# Optional: force the platform your key was created on (.ai vs .cn)
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Adzuna API
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_MAX_HITS=35
# Optional: override the search targeting without editing the code.
# Semicolon-separated. Mind the free-tier quota: queries x locations x 2
# runs/day, plus up to ENRICH_MAX_LOOKUPS x 2, must stay under 100/day
# (tests/test_adzuna_targeting.py asserts it).
# ADZUNA_QUERIES=AI Engineer;Automation Engineer;Data Engineer
# ADZUNA_LOCATIONS=Zurich;Zug
# Radius in km around each location. 30 reaches Zug and Winterthur from
# Zurich in the SAME call; Adzuna's own default is 5, which excluded both.
# ADZUNA_DISTANCE_KM=30

# Gmail (App Password - 16 characters)
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_RECIPIENT=your_email@gmail.com

# SQLite
DB_PATH=./tracker/jobs.db

# --- Optional tuning (defaults shown) ---------------------------------------
# Scoring thresholds. Single source of truth is src/utils.py; these override it.
# THRESHOLD_APPLY=80
# THRESHOLD_REVIEW=70
# Below this many characters of posting text a job is marked
# insufficient_info and can never reach APPLY automatically.
# MIN_DESCRIPTION_CHARS=200
# Cost guard: max LLM evaluations per run. Jobs beyond the cap are left
# unseen and come back on the next run.
# MAX_EVALUATIONS_PER_RUN=30
# Evaluation stage: agent|rules, default rules. `rules` delegates to the
# deterministic evaluator (agents/job_evaluator.py); `agent` runs the
# tool-using decision agent (agents/decision_agent.py), which investigates
# each posting and commits its own APPLY/REVIEW/SKIP with a stored rationale.
# Safety rails stay in code either way. The scheduled workflow runs agent mode.
# EVALUATION_MODE=rules
# Agent mode only: max tool-calling iterations per job. Each iteration is an
# LLM call, so with MAX_EVALUATIONS_PER_RUN it bounds the run's cost.
# AGENT_MAX_ITERATIONS=5
# Orchestration stage: agent|rules, default rules. `rules` runs the three
# legacy scripts (doc_generator, high_score_alert, followup_sender) in the
# old order, failure-tolerant. `agent` runs an LLM orchestrator
# (agents/orchestrator_agent.py) that decides what the run needs (docs,
# alerts, follow-up drafts, bounded re-scores), with the legacy chain as its
# coded fallback. The scheduled workflow runs agent mode.
# ORCHESTRATION_MODE=rules
# Agent mode only: max tool-calling iterations for the orchestrator, and the
# hard cap on REVIEW-band jobs it may re-score per run.
# ORCHESTRATOR_MAX_ITERATIONS=8
# ORCHESTRATOR_MAX_REEVALUATIONS=5
# Description enrichment (agents/description_enricher.py): how many Adzuna
# lookups per run may be spent filling in missing descriptions, and how far
# back to look for the same posting.
# ENRICH_MAX_LOOKUPS=12
# ENRICH_MAX_DAYS_OLD=30
