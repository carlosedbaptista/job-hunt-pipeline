debug_*.py

# Fix scripts at the repo root (never commit)
/*fix*.py
/*hotfix*.py

# Google Drive credentials (sensitive)
config/gdrive_credentials.json
config/gdrive_refresh_token.json
config/oauth2_client_secret.json

# Candidate PII -- restored from base64 secrets in CI
config/candidate_profile.json
# photo.* (not just .png/.jpg): CLAUDE.md specifies the glob, and a
# re-encode to .jpeg/.webp would otherwise become committable.
config/photo.*

# Generated docs (CVs/CLs)
generated_docs/
digests/raw_emails*.json
config/cv_model.txt
config/cover_letter_model.txt
.venv-tools/

# Base64 blobs of the profile, pasted into GitHub Secrets. They decode
# straight back to PII and this repo is public -- never commit one.
CANDIDATE_PROFILE_B64.txt
*_B64.txt

# Patch files applied locally
*.patch
